{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reyhan-shop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://banmwcbbwypvlbpctmyi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_nTwhN7Som7Mf6n3IBA9dnA_ZDE1mmhu"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "reyhan-shop"
    }
  ]
}
