# PostgreSQL / Supabase connection strings
#
# DATABASE_URL (transaction pooler — port 6543):
#   Used by the Next.js app at runtime via @prisma/adapter-pg.
#   Supabase transaction pooler includes ?pgbouncer=true&sslmode=require.
#   Format: postgresql://<user>.<project_ref>:<password>@<project_ref>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# DIRECT_URL (session pooler — port 5432):
#   Used by Prisma CLI (migrate, db push, db pull) for schema operations.
#   Session pooler does NOT use pgbouncer mode; uses sslmode=require.
#   Format: postgresql://<user>.<project_ref>:<password>@<project_ref>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Obtain connection strings from:
#   Supabase Dashboard → Project Settings → Database → Connection Pooling
#
# IMPORTANT: The password may contain special characters that must be
# URL-encoded. For example, a literal `[` → `%5B`, `]` → `%5D`, `@` → `%40`.
# A password with unencoded special characters in a connection URL will
# cause "Can't reach database server" (P1001) or authentication failures.
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@<project_ref>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project_ref>:<password>@<project_ref>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase JS SDK — public env, used for storefront queries (Plan B).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SESSION_SECRET=""
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
OTP_DEBUG_LOG="false"
EMAIL_PROVIDER="console"
EMAIL_DEBUG="false"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
