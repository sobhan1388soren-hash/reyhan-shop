generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id @default(cuid())
  phone            String                @unique
  phoneVerified    Boolean               @default(false)
  email            String?               @unique
  firstName        String?
  lastName         String?
  displayName      String?
  role             UserRole              @default(CUSTOMER)
  status           UserStatus            @default(ACTIVE)
  province         String?
  city             String?
  postalCode       String?
  addressLine      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  addresses        Address[]
  carts            Cart[]
  discountUsages   DiscountUsage[]
  notificationLogs NotificationLog[]
  orders           Order[]
  otpTokens        OtpToken[]
  blogPosts        Post[]                @relation("PostAuthor")
  priceAlerts      PriceAlert[]
  answers          ProductAnswer[]
  priceChanges     ProductPriceHistory[] @relation("PriceChangedBy")
  questions        ProductQuestion[]
  reviews          Review[]
  stockAlerts      StockAlert[]
  wishlists        Wishlist?

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  province      String
  city          String
  postalCode    String?
  addressLine   String
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@map("addresses")
}

model OtpToken {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  attempts  Int        @default(0)
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
  @@index([expiresAt])
  @@index([userId])
  @@map("otp_tokens")
}

model Category {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  description        String?
  image              String?
  sortOrder          Int                @default(0)
  status             CategoryStatus     @default(ACTIVE)
  level              Int                @default(0)
  seoTitle           String?
  seoDescription     String?
  parentId           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  parent             Category?          @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]         @relation("CategoryToParent")
  discountCategories DiscountCategory[]
  productCategories  ProductCategory[]

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id               String                 @id @default(cuid())
  title            String
  slug             String                 @unique
  description      String?
  shortDescription String?
  status           ProductStatus          @default(DRAFT)
  isFeatured       Boolean                @default(false)
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  discountProducts DiscountProduct[]
  orderItems       OrderItem[]
  blogPosts        PostProductRelation[]
  categories       ProductCategory[]
  images           ProductImage[]
  questions        ProductQuestion[]
  specifications   ProductSpecification[]
  variants         ProductVariant[]
  reviews          Review[]
  wishlistItems    WishlistItem[]

  @@index([status])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  assignedAt DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id             String                @id @default(cuid())
  productId      String
  title          String
  sku            String                @unique
  barcode        String?               @unique
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  weight         Int?
  isDefault      Boolean               @default(false)
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  cartItems      CartItem[]
  inventory      Inventory?
  orderItems     OrderItem[]
  priceAlerts    PriceAlert[]
  images         ProductImage[]
  priceHistory   ProductPriceHistory[]
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockAlerts    StockAlert[]
  wishlistItems  WishlistItem[]

  @@index([productId])
  @@index([isActive])
  @@index([isDefault])
  @@map("product_variants")
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId])
  @@map("product_specifications")
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductPriceHistory {
  id             String         @id @default(cuid())
  variantId      String
  price          Int
  compareAtPrice Int?
  changedAt      DateTime       @default(now())
  changedById    String?
  changedBy      User?          @relation("PriceChangedBy", fields: [changedById], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([changedAt])
  @@index([changedById])
  @@map("product_price_history")
}

model Inventory {
  id                String                 @id @default(cuid())
  variantId         String                 @unique
  quantity          Int                    @default(0)
  reservedQuantity  Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  variant           ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions      InventoryTransaction[]

  @@map("inventories")
}

model InventoryTransaction {
  id          String    @id @default(cuid())
  inventoryId String
  change      Int
  reason      String
  orderId     String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String?
  status                OrderStatus     @default(PENDING)
  paymentStatus         PaymentStatus   @default(PENDING)
  subtotal              Int             @default(0)
  shippingCost          Int             @default(0)
  discountAmount        Int             @default(0)
  totalAmount           Int
  discountId            String?
  discountCodeSnapshot  String?
  discountTypeSnapshot  String?
  discountValueSnapshot Int?
  recipientName         String?
  recipientPhone        String?
  province              String?
  city                  String?
  postalCode            String?
  addressLine           String?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  discountUsages        DiscountUsage[]
  items                 OrderItem[]
  user                  User?           @relation(fields: [userId], references: [id])
  payments              Payment[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  productId     String
  variantId     String
  titleSnapshot String
  skuSnapshot   String
  priceSnapshot Int
  quantity      Int
  total         Int
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  amount        Int
  method        PaymentMethod
  provider      PaymentProvider @default(OTHER)
  status        PaymentStatus   @default(PENDING)
  transactionId String?         @unique
  authority     String?
  paidAt        DateTime?
  meta          Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}

model ProductQuestion {
  id        String          @id @default(cuid())
  productId String
  userId    String
  question  String
  status    QuestionStatus  @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  answers   ProductAnswer[]
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("product_questions")
}

model ProductAnswer {
  id         String          @id @default(cuid())
  questionId String
  userId     String
  answer     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
  @@map("product_answers")
}

model PostCategory {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  description    String?
  image          String?
  sortOrder      Int                    @default(0)
  status         CategoryStatus         @default(ACTIVE)
  level          Int                    @default(0)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  parent         PostCategory?          @relation("PostCategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children       PostCategory[]         @relation("PostCategoryToParent")
  posts          PostCategoryRelation[]

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
  @@map("post_categories")
}

model Post {
  id             String                 @id @default(cuid())
  title          String
  slug           String                 @unique
  excerpt        String?
  content        String
  coverImage     String?
  status         PostStatus             @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  authorId       String?
  publishedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  categories     PostCategoryRelation[]
  products       PostProductRelation[]
  author         User?                  @relation("PostAuthor", fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("posts")
}

model PostProductRelation {
  postId     String
  productId  String
  sortOrder  Int      @default(0)
  assignedAt DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
  @@index([postId, sortOrder])
  @@map("post_product_relations")
}

model PostCategoryRelation {
  postId     String
  categoryId String
  assignedAt DateTime     @default(now())
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("post_category_relations")
}

model Discount {
  id                String             @id @default(cuid())
  code              String             @unique
  type              DiscountType
  scope             DiscountScope      @default(ORDER)
  value             Int
  minOrderAmount    Int?
  maxDiscountAmount Int?
  maxUses           Int?
  usedCount         Int                @default(0)
  maxUsesPerUser    Int?               @default(1)
  isActive          Boolean            @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categories        DiscountCategory[]
  products          DiscountProduct[]
  usages            DiscountUsage[]

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("discounts")
}

model DiscountProduct {
  discountId String
  productId  String
  assignedAt DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

model DiscountCategory {
  discountId String
  categoryId String
  assignedAt DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
  @@map("discount_categories")
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  userId     String?
  orderId    String?
  usedAt     DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@unique([discountId, orderId])
  @@index([discountId])
  @@index([userId])
  @@index([orderId])
  @@map("discount_usages")
}

model Banner {
  id                 String          @id @default(cuid())
  placement          BannerPlacement
  title              String
  description        String?
  imageUrl           String?
  primaryLinkHref    String?
  primaryLinkLabel   String?
  secondaryLinkHref  String?
  secondaryLinkLabel String?
  isActive           Boolean         @default(false)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

model PriceAlert {
  id           String         @id @default(cuid())
  userId       String
  variantId    String
  initialPrice Int
  targetPrice  Int?
  status       Boolean        @default(true)
  notifiedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
  @@index([status])
  @@map("price_alerts")
}

model StockAlert {
  id         String         @id @default(cuid())
  userId     String
  variantId  String
  status     Boolean        @default(true)
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
  @@index([status])
  @@map("stock_alerts")
}

model NotificationLog {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  variantId String?
  message   String
  status    String           @default("SENT")
  sentAt    DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([variantId])
  @@index([type])
  @@index([sentAt])
  @@map("notification_logs")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  shareId   String?        @unique
  shareSlug String?        @unique
  isPublic  Boolean        @default(false)
  title     String         @default("لیست علاقه‌مندی‌ها")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     WishlistItem[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@map("wishlists")
}

model WishlistItem {
  id         String          @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  notes      String?
  addedAt    DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  RESET_PHONE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
  CARD_TO_CARD
}

enum PaymentProvider {
  ZARINPAL
  MELLAT
  PASARGAD
  MANUAL
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionStatus {
  PENDING
  ANSWERED
  CLOSED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerPlacement {
  HERO
  PROMO
}

enum NotificationType {
  PRICE_DROP
  BACK_IN_STOCK
  ORDER_PLACED
  ORDER_PAID
  ORDER_SHIPPED
}
